# JWT secret for admin panel authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Admin password hash (bcrypt, base64-encoded)
# Generate with: node scripts/generate-password.js <tu-contraseña>
ADMIN_PASSWORD_HASH_B64=

# Supabase (optional — used for database in production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (optional — used for image uploads in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
